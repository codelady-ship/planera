# Local defaults match docker-compose.yml; production values live in Render.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/randevum
SPRING_DATASOURCE_USERNAME=randevum
SPRING_DATASOURCE_PASSWORD=randevum
REDIS_URL=redis://localhost:6379
# At least 32 bytes; empty = a random key on every start.
JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser; empty = none.
CORS_ALLOWED_ORIGINS=
SPRING_PROFILES_ACTIVE=demo
